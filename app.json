{
  "expo": {
    "name": "Tingog",
    "slug": "tingog",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.translate.tingog",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Tingog needs speech recognition to write the transcript.",
        "NSMicrophoneUsageDescription": "Tingog needs the microphone to hear the lecture.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.translate.tingog",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Tingog needs the microphone to hear the lecture.",
          "speechRecognitionPermission": "Tingog needs speech recognition to write the transcript.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-document-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "ba8bf801-7536-4ee7-b396-524875928ece"
      }
    },
    "owner": "centinel_cen"
  }
}
